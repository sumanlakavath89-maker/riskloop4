# RiskLoop Backend Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# Server Configuration
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000

# Reverse Proxy Configuration (set to '1' for Render/Heroku/AWS ALB/Cloudflare, or 'true')
TRUST_PROXY=1

# CORS Configuration (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080

# Rate Limiting Configuration (Defaults provided below)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=500
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AI_SCREENSHOT_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_MAX_REQUESTS=30
SUPPORT_TICKET_RATE_LIMIT_MAX_REQUESTS=10

# Session Secret (generate a random string)
SESSION_SECRET=your-super-secret-session-key-change-this

# =============================================================================
# INDIAN BROKERS
# =============================================================================

# Angel One (SmartAPI)
# Get credentials from: https://smartapi.angelone.in/
ANGELONE_API_KEY=
ANGELONE_CLIENT_ID=
ANGELONE_MPIN=
ANGELONE_TOTP_SECRET=

# FYERS (v3 API)
# Get credentials from: https://myapi.fyers.in/
# App ID format: ClientID-100 (e.g., XC12345-100)
FYERS_APP_ID=
FYERS_SECRET_ID=
FYERS_REDIRECT_URI=http://localhost:3000/api/auth/fyers/callback

# Dhan (DhanHQ v2 API)
# Get credentials from: https://web.dhan.co/ -> Profile -> DhanHQ APIs -> Access Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# Upstox (v2 API)
# Get credentials from: https://upstox.com/developer/api-documentation -> Create App
UPSTOX_API_KEY=
UPSTOX_API_SECRET=
UPSTOX_REDIRECT_URI=http://localhost:3000/api/auth/upstox/callback

# Shoonya (Finvasia Noren API)
# Get credentials from: https://prism.finvasia.com/ -> API Key & Vendor Code
SHOONYA_USER_ID=
SHOONYA_PASSWORD=
SHOONYA_API_KEY=
SHOONYA_VENDOR_CODE=
SHOONYA_IMEI=
SHOONYA_TOTP_SECRET=

# Alice Blue (ANT API v2)
# Get credentials from: https://ant.aliceblueonline.com/ -> Developer API / API Key
ALICEBLUE_USER_ID=
ALICEBLUE_API_KEY=

# Kotak Neo (Trade API)
# Get credentials from: https://napi.kotaksecurities.com/devportal -> Applications
KOTAKNEO_CONSUMER_KEY=
KOTAKNEO_CONSUMER_SECRET=
KOTAKNEO_MOBILE_NUMBER=
KOTAKNEO_PASSWORD=
KOTAKNEO_SESSION_TOKEN=

# SAMCO (StockNote API)
# Get credentials from: https://developers.stocknote.com/ -> Developer Portal
SAMCO_USER_ID=
SAMCO_PASSWORD=
SAMCO_YOB=

# =============================================================================
# FOREX / MT5
# =============================================================================

# MetaTrader 5 (MT5 Read-Only Connector)
# Credentials from your MT5 Broker (e.g. Fusion Markets, Pepperstone, IC Markets, Exness, XM, FP Markets, Vantage, FXTM)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_GATEWAY_URL=
MT5_API_TOKEN=

# MT5 Economic Calendar Bridge Secret (Required in x-mt5-bridge-secret header)
MT5_CALENDAR_BRIDGE_SECRET=

# =============================================================================
# MARKET NEWS APIS
# =============================================================================

# NewsAPI (Primary Provider)
# Get free API key from: https://newsapi.org/
NEWSAPI_API_KEY=

# GNews (Secondary / Fallback Provider)
# Get free API key from: https://gnews.io/
GNEWS_API_KEY=

# =============================================================================
# ECONOMIC CALENDAR APIS
# =============================================================================

# Financial Modeling Prep (FMP) API Key
# Get key from: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=

# News Cache TTL in milliseconds (default: 15 minutes = 900000 ms)
NEWS_CACHE_TTL_MS=900000

# =============================================================================
# AI SUPPORT ASSISTANT (OPENAI)
# =============================================================================
# OpenAI API Key for intelligent RiskLoop Support Assistant
# Get key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# =============================================================================
# SUPABASE DATABASE & AUTHENTICATION
# =============================================================================

# Supabase Project URL (e.g. https://your-project-id.supabase.co)
SUPABASE_URL=

# Supabase Public Anon Key (safe for frontend & client-side requests)
SUPABASE_ANON_KEY=

# Supabase Service Role Key (Keep secret! Used for backend admin operations only)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret (for verifying client auth tokens in backend API)
SUPABASE_JWT_SECRET=

# =============================================================================
# LOGGING
# =============================================================================

# Log Level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Log to file (true/false)
LOG_TO_FILE=false

# =============================================================================
# SECURITY
# =============================================================================

# Rate limiting (requests per 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# API Request timeout (milliseconds)
API_TIMEOUT=30000

# =============================================================================
# CLOUDINARY CLOUD STORAGE
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=



